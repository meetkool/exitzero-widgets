{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/meetkool/exitzero-widgets/schema.json",
  "title": "ExitZero widget manifest",
  "type": "object",
  "required": ["id", "name", "body"],
  "properties": {
    "schemaVersion": { "type": "integer", "minimum": 1, "default": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string" },
    "description": { "type": "string" },
    "author": { "type": "string" },
    "version": { "type": "string" },
    "icon": { "type": "string" },
    "accent": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "layout": {
      "type": "object",
      "properties": {
        "span": { "type": "integer", "minimum": 1, "maximum": 2 },
        "minSpan": { "type": "integer", "minimum": 1, "maximum": 2 },
        "maxSpan": { "type": "integer", "minimum": 1, "maximum": 2 },
        "height": { "type": "number" },
        "minHeight": { "type": "number" },
        "maxHeight": { "type": "number" }
      }
    },
    "config": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "label"],
        "properties": {
          "key": { "type": "string" },
          "label": { "type": "string" },
          "type": { "enum": ["string", "number"] },
          "default": { "type": "string" },
          "hint": { "type": "string" },
          "required": { "type": "boolean" }
        }
      }
    },
    "data": {
      "type": "object",
      "required": ["url"],
      "properties": {
        "url": { "type": "string", "pattern": "^https://" },
        "method": { "enum": ["GET", "POST"] },
        "headers": { "type": "object" },
        "refreshSeconds": { "type": "integer", "minimum": 30 },
        "root": { "type": "string" }
      }
    },
    "body": {
      "type": "array",
      "items": { "$ref": "#/definitions/component" }
    }
  },
  "definitions": {
    "component": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "enum": [
            "label", "text", "metric", "iconBadge", "badge",
            "progressBar", "progressRing", "row", "column",
            "list", "divider", "spacer"
          ]
        },
        "showIf": { "type": "string" },
        "children": {
          "type": "array",
          "items": { "$ref": "#/definitions/component" }
        },
        "item": { "$ref": "#/definitions/component" }
      }
    }
  }
}
