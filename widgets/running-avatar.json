{
  "schemaVersion": 1,
  "id": "running-avatar",
  "name": "The Runner",
  "description": "A little 3D you, jogging laps on your dashboard. Never stops. Neither should you.",
  "author": "meetkool",
  "version": "1.0.1",
  "icon": "directions_run",
  "accent": "#F77F00",
  "tags": [
    "fun",
    "3d"
  ],
  "layout": {
    "span": 2,
    "minSpan": 1,
    "maxSpan": 2,
    "height": 190,
    "minHeight": 180,
    "maxHeight": 300
  },
  "config": [
    {
      "key": "pace",
      "label": "Seconds per lap",
      "type": "number",
      "default": "6",
      "hint": "Lower is faster. 3 is a sprint, 12 is a stroll.",
      "required": true
    }
  ],
  "body": [
    {
      "type": "row",
      "justify": "between",
      "align": "center",
      "children": [
        {
          "type": "label",
          "text": "Still moving"
        },
        {
          "type": "badge",
          "text": "{{config.pace ?? 6}}s / lap",
          "color": "orange"
        }
      ]
    },
    {
      "type": "avatar3d",
      "color": "orange",
      "size": 110,
      "secondsPerLap": "{{config.pace ?? 6}}",
      "showTrack": true
    }
  ]
}
